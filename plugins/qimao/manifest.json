{
  "id": "qimao",
  "name": "七猫小说",
  "version": "1.0.0",
  "description": "七猫小说网站支持插件（官方）",
  "author": "艾特阅读团队",
  "homepage": "https://github.com/dengcb/weixin-reader-desktop",
  "sourceType": "web",
  "renderMode": "webview",
  "site": {
    "domain": [
      "qimao.com"
    ],
    "homeUrl": "https://www.qimao.com/",
    "readerPattern": "/(reader/index/\\d+|shuku/\\d+-\\d+)"
  },
  "capabilities": {
    "wideMode": true,
    "hideToolbar": true,
    "autoFlip": true,
    "chapterNav": true,
    "progressTracker": true,
    "doubleColumn": true,
    "hideNavbar": true,
    "hideCursor": true,
    "remoteControl": true,
    "nativeTheme": true
  },
  "builtin": true,
  "icon": "data:image/vnd.microsoft.icon;base64,"
}
