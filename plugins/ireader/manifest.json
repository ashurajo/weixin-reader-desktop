{
  "id": "ireader",
  "name": "掌阅",
  "version": "0.2.0",
  "description": "掌阅 PC 网页版网站支持插件（官方）",
  "author": "艾特阅读团队",
  "homepage": "https://github.com/dengcb/weixin-reader-desktop",
  "sourceType": "web",
  "renderMode": "webview",
  "site": {
    "domain": [
      "pc.ireader.com"
    ],
    "homeUrl": "https://pc.ireader.com/",
    "readerPattern": "/reader/\\d+"
  },
  "capabilities": {
    "wideMode": true,
    "autoFlip": true,
    "chapterNav": true,
    "doubleColumn": true,
    "hideToolbar": true,
    "progressTracker": true,
    "nativeTheme": true
  },
  "icon": "data:image/png;base64,"
}
